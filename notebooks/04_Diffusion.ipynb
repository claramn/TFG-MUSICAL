    "            \n",
    "        if loss.item() < best_loss:\n",
    "            best_loss = loss.item()\n",
    "            if model_path is not None:\n",
    "                torch.save(model.state_dict(), model_path)\n",
    "                if verb:\n",
    "                    print(f\"Model temporally saved at epoch {epoch} with loss {best_loss}\")\n",
